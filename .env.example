# Choose a provider with an OpenAI-compatible chat completions API.
# Free-tier availability, model names, and limits vary by provider.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Optional Telegram bot interface. Leave blank to use terminal chat only.
TELEGRAM_BOT_TOKEN=

# Local SQLite memory database
DATABASE_PATH=agent_memory.sqlite3

# Optional: max search results per research request
SEARCH_RESULTS=5
